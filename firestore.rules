rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection: readable by all, editable
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Careers collection: readable by all, editable
    match /careers/{careerId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact form submissions: can be created by anyone, readable
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }

    // Profile collection: readable and writable by all
    match /profile/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Food recommendations collection: readable and writable
    match /food_recommendations/{foodId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
